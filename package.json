{
  "name": "mr-chu-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node script/build-tokens.mjs",
    "tokens:watch": "node script/build-tokens.mjs --watch",
    "notion:sync": "node script/sync-notion.mjs",
    "predev": "npm run tokens",
    "dev": "concurrently -n tokens,next -c gray,cyan \"npm:tokens:watch\" \"next dev --turbopack\"",
    "prebuild": "npm run tokens",
    "build": "next build",
    "build:check": "npm run tokens && NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "storybook": "npm run tokens && ./script/with-node.sh storybook dev -p 6006",
    "build-storybook": "npm run tokens && ./script/with-node.sh storybook build",
    "pr": "node script/create.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@karrotmarket/react-monochrome-icon": "^1.27.0",
    "@microlink/react": "^5.5.24",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@reduxjs/toolkit": "^2.8.2",
    "@seed-design/react-icon": "^0.7.4",
    "@tanstack/react-query": "^5.67.1",
    "@types/three": "^0.174.0",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.4.10",
    "next": "15.2.8",
    "notion-client": "^7.7.1",
    "posthog-js": "^1.376.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-notion-x": "^7.10.0",
    "react-redux": "^9.2.0",
    "react-responsive": "^10.0.1",
    "swiper": "^11.2.10",
    "three": "^0.182.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@octokit/rest": "^22.0.1",
    "@storybook/nextjs": "^10.6.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "inquirer": "^13.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "raw-loader": "^4.0.2",
    "sass": "^1.85.1",
    "storybook": "^10.6.0",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
